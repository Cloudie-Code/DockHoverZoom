#: Settings.ui
msgid "Magnify icons on hover"
msgstr "Handitu ikonoak gainetik pasatzean"

#: Settings.ui
msgid "Enlarge the icons under the mouse pointer, like the macOS dock."
msgstr ""
"Handitu saguaren erakuslearen azpiko ikonoak, macOS-eko atrakagunean bezala."

#: Settings.ui
msgid "Magnification size"
msgstr "Handitzearen tamaina"

#: prefs.js
msgid "Hide icon backgrounds"
msgstr "Ezkutatu ikonoen atzeko planoa"

#: prefs.js
msgid "Bounce icons when launching apps"
msgstr "Errebotea egin ikonoek aplikazioak abiaraztean"
