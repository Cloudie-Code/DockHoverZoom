#: Settings.ui
msgid "Magnify icons on hover"
msgstr "Збільшувати значки при наведенні"

#: Settings.ui
msgid "Enlarge the icons under the mouse pointer, like the macOS dock."
msgstr "Збільшувати значки під вказівником миші, як у доку macOS."

#: Settings.ui
msgid "Magnification size"
msgstr "Ступінь збільшення"

#: prefs.js
msgid "Hide icon backgrounds"
msgstr "Приховати тло піктограм"

#: prefs.js
msgid "Bounce icons when launching apps"
msgstr "Підстрибування піктограм під час запуску програм"
