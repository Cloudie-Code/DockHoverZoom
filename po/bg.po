#: Settings.ui
msgid "Magnify icons on hover"
msgstr "Увеличаване на иконите при посочване"

#: Settings.ui
msgid "Enlarge the icons under the mouse pointer, like the macOS dock."
msgstr ""
"Уголемяване на иконите под показалеца на мишката, като в дока на macOS."

#: Settings.ui
msgid "Magnification size"
msgstr "Размер на увеличението"

#: prefs.js
msgid "Hide icon backgrounds"
msgstr "Скриване на фона на иконите"

#: prefs.js
msgid "Bounce icons when launching apps"
msgstr "Подскачане на иконите при стартиране на приложения"
