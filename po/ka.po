#: Settings.ui
msgid "Magnify icons on hover"
msgstr "ხატულების გადიდება მიტანისას"

#: Settings.ui
msgid "Enlarge the icons under the mouse pointer, like the macOS dock."
msgstr ""
"თაგუნას მაჩვენებლის ქვეშ მყოფი ხატულების გადიდება, როგორც macOS-ის დოკში."

#: Settings.ui
msgid "Magnification size"
msgstr "გადიდების ზომა"

#: prefs.js
msgid "Hide icon backgrounds"
msgstr "ხატულების ფონის დამალვა"

#: prefs.js
msgid "Bounce icons when launching apps"
msgstr "აპების გაშვებისას ხატულების ახტომა"
